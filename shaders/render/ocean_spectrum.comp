#version 460 core
//  shaders/render/ocean_spectrum.comp                                  [DEV 2]
//  Spectre initial de l'océan h0(k) (Tessendorf 2001) pour chaque cascade, recalculé seulement quand le
//  vent ou les paramètres changent. Écrit dans SSBO_OceanSpectrum : vec4(h0(k), conj(h0(-k))).
//    * JONSWAP (Hasselmann 1973) : vitesse du vent à 10 m (uEnv.windDirSpeed.z) et fetch ;
//    * étalement directionnel de Donelan-Banner (normalisé, sans fonction Gamma) ;
//    * chaque cascade ne garde que sa bande de nombres d'onde [uCutLow, uCutHigh) : pas de double compte.
#include "common/global_ubo.glsl"
#include "render/ocean_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

uniform vec2  uWindDir;     // direction (X, Z) unitaire vers laquelle souffle le vent
uniform float uWindSpeed;   // m/s à 10 m
uniform float uFetch;       // m
uniform float uAmplitude;   // multiplicateur artistique (1 = physique)

const float kG = 9.81;

// Densité spectrale JONSWAP en pulsation (m² s).
float Jonswap(float w, float wp, float alpha) {
    const float gamma = 3.3;
    float sigma = w <= wp ? 0.07 : 0.09;
    float r = exp(-(w - wp) * (w - wp) / (2.0 * sigma * sigma * wp * wp));
    return alpha * kG * kG / pow(w, 5.0) * exp(-1.25 * pow(wp / w, 4.0)) * pow(gamma, r);
}

// Étalement directionnel de Donelan-Banner (1985), intégrale sur θ = 1.
float DonelanBanner(float theta, float w, float wp) {
    float ratio = w / wp;
    float beta = ratio < 0.95 ? 2.61 * pow(ratio, 1.3)
               : ratio < 1.6  ? 2.28 * pow(ratio, -1.3)
                              : pow(10.0, -0.4 + 0.8393 * exp(-0.567 * log(ratio * ratio)));
    float sech = 1.0 / cosh(clamp(beta * theta, -9.0, 9.0));
    return beta / (2.0 * tanh(beta * PI_OCEAN)) * sech * sech;
}

vec2 GaussianPair(uvec3 seed) {
    uvec3 h = OceanHash3(seed);
    float u1 = max(float(h.x >> 8u) * (1.0 / 16777216.0), 1e-7);
    float u2 = float(h.y >> 8u) * (1.0 / 16777216.0);
    float r  = sqrt(-2.0 * log(u1));
    return vec2(r * cos(2.0 * PI_OCEAN * u2), r * sin(2.0 * PI_OCEAN * u2));
}

vec2 H0(ivec2 n, int cascade) {
    float L  = uOceanCascadeSize[cascade];
    float dk = 2.0 * PI_OCEAN / L;
    vec2  k  = vec2(n - uOceanN / 2) * dk;
    float kl = length(k);
    if (kl < uOceanCutLow[cascade] || kl >= uOceanCutHigh[cascade] || kl < 1e-6) return vec2(0.0);

    float U     = max(uWindSpeed, 0.5);
    float F     = max(uFetch, 100.0);
    float alpha = 0.076 * pow(U * U / (F * kG), 0.22);
    float wp    = 22.0 * pow(kG * kG / (U * F), 1.0 / 3.0);

    float w      = sqrt(kG * kl);         // eau profonde
    float dwdk   = kG / (2.0 * w);
    float theta  = atan(k.y, k.x) - atan(uWindDir.y, uWindDir.x);
    theta        = mod(theta + PI_OCEAN, 2.0 * PI_OCEAN) - PI_OCEAN;
    float S      = Jonswap(w, wp, alpha) * DonelanBanner(theta, w, wp) * dwdk / kl;  // m⁴ (spectre en k)
    // Atténuation des vaguelettes plus courtes que ~1 cm (pas de capillarité dans ce modèle).
    S *= exp(-kl * kl * 1e-4);
    vec2 xi = GaussianPair(uvec3(uvec2(n), uint(cascade) * 7919u + 17u));
    return xi * sqrt(S * dk * dk) * uAmplitude;  // E[|h0|²] = S Δk²
}

void main() {
    ivec2 n = ivec2(gl_GlobalInvocationID.xy);
    int   c = int(gl_GlobalInvocationID.z);
    if (n.x >= uOceanN || n.y >= uOceanN || c >= OCEAN_CASCADES) return;
    ivec2 m = (uOceanN - n) % uOceanN;  // indice de -k
    vec2  a = H0(n, c);
    vec2  b = H0(m, c);
    spectrum[OceanSpectrumIndex(n, c)] = vec4(a, b.x, -b.y);
}
