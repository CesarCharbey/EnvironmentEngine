#version 460 core
//  shaders/render/ocean_mip.comp                                       [DEV 2]
//  Mips des cartes de l'océan (2D array, toutes les couches d'un niveau en un dispatch).
//  Remplace glGenerateTextureMipmap, qui prend un chemin lent sur NVIDIA pour cette texture (0,19 ms
//  mesurés en 256² × 6 couches RGBA16F, contre quelques µs ici ; même constat que voxel_mip.comp).
//  Moyenne 2 × 2 du niveau N-1 (texelFetch) écrite au niveau N (image) : niveaux distincts.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = IMG_WaterOut) writeonly uniform image2DArray uDst;  // niveau N
layout(binding = TEX_OceanDisplacement) uniform sampler2DArray uSrc;          // même texture, niveau N-1

uniform int uSrcLevel;

void main() {
    ivec3 p = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(p, imageSize(uDst)))) return;
    ivec3 q = ivec3(2 * p.xy, p.z);
    vec4  s = texelFetch(uSrc, q, uSrcLevel) + texelFetch(uSrc, q + ivec3(1, 0, 0), uSrcLevel)
            + texelFetch(uSrc, q + ivec3(0, 1, 0), uSrcLevel) + texelFetch(uSrc, q + ivec3(1, 1, 0), uSrcLevel);
    imageStore(uDst, p, 0.25 * s);
}
