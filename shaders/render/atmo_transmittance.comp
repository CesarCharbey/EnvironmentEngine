#version 460 core
#include "common/global_ubo.glsl"
#include "render/atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = IMG_AtmoLutOut) writeonly uniform image2D outTransmittance;

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outTransmittance);
    if (pix.x >= size.x || pix.y >= size.y) return;

    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    float Rb = uAtmo.uRadiiAndScaleHeights.x;
    float Rt = uAtmo.uRadiiAndScaleHeights.y;

    float r, mu;
    UVToTransmittanceParams(uv, Rb, Rt, r, mu);

    vec3 p = vec3(0.0, r, 0.0);
    vec3 d = vec3(sqrt(max(0.0, 1.0 - mu * mu)), mu, 0.0);

    float tMax = RaySphereIntersectNearest(p, d, Rt);
    const int kSteps = 40;
    float dt = tMax / float(kSteps);

    vec3 opticalDepth = vec3(0.0);
    for (int i = 0; i < kSteps; ++i) {
        vec3 pos = p + d * ((float(i) + 0.5) * dt);
        float hKm = length(pos) - Rb;
        vec3 scaR, scaM, ext;
        SampleMediumKm(hKm, scaR, scaM, ext);
        opticalDepth += ext * dt;
    }

    vec3 transmittance = exp(-opticalDepth);
    imageStore(outTransmittance, pix, vec4(transmittance, 1.0));
}