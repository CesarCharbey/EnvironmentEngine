#version 460 core
//  shaders/render/ibl_capture.comp                                     [DEV 2]
//  IBL dynamique, étape 1 : capture du ciel dans le niveau 0 de la cubemap d'environnement
//  (6 faces en un seul dispatch : aucune couture entre faces capturées à des instants différents).
//
//  * Au-dessus de l'horizon : la sky-view (Hillaire 2020, fond de ciel nocturne compris), exactement le
//    ciel affiché. SANS les disques du soleil et de la lune : leur reflet spéculaire est déjà calculé
//    analytiquement par la résolution différée (GGX) ; les inclure le compterait deux fois.
//  * Sous l'horizon : la sky-view ne contient que l'air entre la caméra et le sol. On y ajoute le sol
//    lui-même (albédo de l'atmosphère éclairé par le soleil, la lune et le ciel), atténué par l'air
//    traversé : sans lui, l'hémisphère bas serait noir (faces tournées vers le bas, reflets rasants).
//    Le soleil et la lune qui l'éclairent sont atténués par l'ombre moyenne des nuages autour de la caméra.
//  * Nuages (si VolumetricGodRaysSystem les publie) : même modèle de densité (cloud_density.glsl) et même
//    marche (cloud_march.glsl) que les nuages affichés, allégés (uCloudSteps pas, uCloudLightSteps pas de
//    lumière, sans bruit de détail ni curl : inutiles à cette résolution), composés sur le ciel et le sol.
//    L'irradiance et le spéculaire préfiltré voient ainsi la couverture réelle (ciel couvert -> ambiant gris).
#include "common/global_ubo.glsl"
#include "render/atmo_common.glsl"
#include "render/sky_lighting.glsl"
#include "render/ibl_common.glsl"
#include "render/cloud_density.glsl"
#include "render/cloud_march.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = IMG_IblOut) writeonly uniform imageCube uEnvOut;

uniform bool uIncludeGround;
uniform bool uClouds;            // nuages publiés et actifs (CloudParams.valid)
uniform int  uCloudSteps;        // pas principaux
uniform int  uCloudLightSteps;   // pas vers l'astre
uniform bool uCloudShadowValid;  // clouds.shadowMap calculée (ombre des nuages au sol)
uniform vec2 uCloudShadowCenter; // uv de la caméra dans la carte d'ombre

layout(binding = TEX_CloudShadow) uniform sampler2D uCloudShadow;

const float kHalfMax = 60000.0;  // borne du RGBA16F

shared float sShadowSamples[16];
shared vec3  sSkyAvg;
shared vec3  sGroundE;

// Luminance du sol vu dans la direction dir (dir.y < 0), atténuée par l'air jusqu'au point visé.
vec3 GroundRadiance(vec3 dir, vec3 groundE) {
    float Rb  = uAtmo.uRadiiAndScaleHeights.x;
    float hKm = max(uEnv.cameraPosition.y * 0.001, PLANET_RADIUS_OFFSET);
    // Distance au sol : plan horizontal, bornée par la distance de l'horizon géométrique.
    float dKm = min(hKm / max(-dir.y, 1e-4), sqrt(2.0 * Rb * hKm + hKm * hKm));
    vec3 scaR, scaM, ext;
    SampleMediumKm(0.5 * hKm, scaR, scaM, ext);  // densité moyenne entre la caméra et le sol
    return uAtmo.uGroundAlbedoAndTurb.xyz * groundE / PI * exp(-ext * dKm);
}

void main() {
    ivec3 id     = ivec3(gl_GlobalInvocationID);
    int   size   = imageSize(uEnvOut).x;
    bool  inside = id.x < size && id.y < size;
    uint  lid    = gl_LocalInvocationIndex;

    // Ombre moyenne des nuages, ciel moyen et éclairement du sol : constants sur tout le groupe.
    if (lid < 16u) {
        if (uClouds && uCloudShadowValid) {
            vec2 o = (vec2(lid & 3u, lid >> 2u) - 1.5) / 1.5 * 0.15;
            sShadowSamples[lid] = textureLod(uCloudShadow, uCloudShadowCenter + o, 0.0).r;
        } else {
            sShadowSamples[lid] = 1.0;
        }
    }
    barrier();
    if (lid == 0u) {
        sSkyAvg = SkyAverage();
        float shadow = 0.0;
        for (int i = 0; i < 16; ++i) shadow += sShadowSamples[i];
        shadow *= (1.0 / 16.0);
        if (uIncludeGround && AtmoValid()) {
            vec3 sunDir  = normalize(envSunDirection());
            vec3 moonDir = normalize(envMoonDirection());
            sGroundE = (SunIlluminanceTOA()  * LightTransmittance(0.0, sunDir,  SunAngularRadius())  * max(sunDir.y, 0.0)
                      + MoonIlluminanceTOA() * LightTransmittance(0.0, moonDir, MoonAngularRadius()) * max(moonDir.y, 0.0)) * shadow
                     + PI * sSkyAvg;
        } else {
            sGroundE = vec3(0.0);
        }
    }
    barrier();
    if (!inside) return;

    vec3 dir = CubeTexelDir(id.z, id.xy, size);
    vec3 L   = SkyLuminance(dir);
    if (uClouds) {
        float overcast = smoothstep(0.4, 0.95, uEnv.weatherExtra.x);
        L = mix(L, sSkyAvg, overcast);
    }
    if (uIncludeGround && dir.y < 0.0 && AtmoValid()) L += GroundRadiance(dir, sGroundE);
    if (uClouds) {
        vec3  cam = envCameraPosition();
        float tA, tB;
        bool  behind;
        if (CloudSegment(cam, dir, 1e30, tA, tB, behind)) {
            float jitter = InterleavedGradientNoise(vec2(id.xy) + 17.0 * float(id.z));
            vec4  c = MarchClouds(cam, dir, tA, tB, uCloudSteps, uCloudLightSteps, false, jitter, sSkyAvg);
            L = L * c.a + c.rgb;
        }
    }
    imageStore(uEnvOut, id, vec4(min(L, vec3(kHalfMax)), 1.0));
}
