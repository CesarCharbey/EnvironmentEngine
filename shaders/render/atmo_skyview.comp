#version 460 core
//  shaders/render/atmo_skyview.comp                                    [DEV 2]
//  Sky-View LUT (Hillaire 2020, section 5.3) : luminance du ciel (cd/m²) vue depuis la caméra,
//  recalculée chaque frame. Paramétrage : voir UVToSkyViewDir / SkyViewDirToUV (atmo_common.glsl).
//  Deux sources : le soleil et la lune (lumière solaire réfléchie, même modèle physique).
#include "common/global_ubo.glsl"
#include "render/atmo_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = TEX_AtmoTransmittance)   uniform sampler2D uTransmittanceLUT;
layout(binding = TEX_AtmoMultiScattering) uniform sampler2D uMultiScatteringLUT;
layout(rgba16f, binding = IMG_AtmoLutOut) writeonly uniform image2D outSkyView;

const int   kSteps   = 32;
const float kHalfMax = 65000.0;  // borne du RGBA16F (max 65504)

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outSkyView);
    if (pix.x >= size.x || pix.y >= size.y) return;

    float Rb = uAtmo.uRadiiAndScaleHeights.x;
    float Rt = uAtmo.uRadiiAndScaleHeights.y;

    // Point de vue : altitude réelle de la caméra (l'horizon de la LUT en dépend)
    float viewR = AtmoViewRadiusKm();
    vec3 camPos = vec3(0.0, viewR, 0.0);

    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec3 rayDir = UVToSkyViewDir(uv, viewR, Rb);

    float tAtmo   = RaySphereIntersectNearest(camPos, rayDir, Rt);
    float tGround = RaySphereIntersectNearest(camPos, rayDir, Rb);
    float tMax    = (tGround > 0.0) ? min(tAtmo, tGround) : tAtmo;

    vec3 sunDir  = normalize(uEnv.sunDirIlluminance.xyz);
    vec3 moonDir = normalize(uEnv.moonDirPhase.xyz);
    float mieG   = uAtmo.uRayleighScattering.w;

    float cosSun  = dot(rayDir, sunDir);
    float cosMoon = dot(rayDir, moonDir);

    float phaseR_Sun  = PhaseRayleigh(cosSun);
    float phaseM_Sun  = PhaseCornetteShanksMie(cosSun, mieG);
    float phaseR_Moon = PhaseRayleigh(cosMoon);
    float phaseM_Moon = PhaseCornetteShanksMie(cosMoon, mieG);

    // Éclairements au sommet de l'atmosphère (lux). La lune renvoie la lumière du soleil :
    // même couleur, intensité moonParams.x (phase déjà incluse côté CPU). La lumière cendrée
    // (moonParams.z) n'éclaire que le disque lunaire, pas l'atmosphère terrestre.
    vec3 sunIlluminance  = uEnv.sunColorAngular.rgb * uEnv.sunDirIlluminance.w;
    vec3 moonIlluminance = uEnv.sunColorAngular.rgb * uEnv.moonParams.x;

    float dt = tMax / float(kSteps);
    vec3 L = vec3(0.0);
    vec3 throughput = vec3(1.0);

    for (int i = 0; i < kSteps; ++i) {
        vec3 pos = camPos + rayDir * ((float(i) + 0.5) * dt);
        float posR = length(pos);

        vec3 scaR, scaM, ext;
        SampleMediumKm(posR - Rb, scaR, scaM, ext);

        vec3 sampleTrans = exp(-ext * dt);
        vec3 sint = (vec3(1.0) - sampleTrans) / max(ext, vec3(1e-6));

        vec3 up = pos / posR;
        float muSun  = dot(up, sunDir);
        float muMoon = dot(up, moonDir);

        vec3 transToSun  = texture(uTransmittanceLUT, TransmittanceParamsToUV(posR, muSun,  Rb, Rt)).rgb
                         * PlanetShadow(pos, sunDir, Rb);
        vec3 transToMoon = texture(uTransmittanceLUT, TransmittanceParamsToUV(posR, muMoon, Rb, Rt)).rgb
                         * PlanetShadow(pos, moonDir, Rb);

        // Multi-diffusion : Ψms dépend de l'altitude et du zénith de la source (pas de l'ombre locale)
        vec3 psiMsSun  = texture(uMultiScatteringLUT, MultiScatteringParamsToUV(posR, muSun,  Rb, Rt)).rgb;
        vec3 psiMsMoon = texture(uMultiScatteringLUT, MultiScatteringParamsToUV(posR, muMoon, Rb, Rt)).rgb;
        vec3 scaTotal  = scaR + scaM;

        vec3 inScatSun  = (scaR * phaseR_Sun  + scaM * phaseM_Sun)  * transToSun  + scaTotal * psiMsSun;
        vec3 inScatMoon = (scaR * phaseR_Moon + scaM * phaseM_Moon) * transToMoon + scaTotal * psiMsMoon;

        L += throughput * (inScatSun * sunIlluminance + inScatMoon * moonIlluminance) * sint;
        throughput *= sampleTrans;
    }

    imageStore(outSkyView, pix, vec4(min(L, vec3(kHalfMax)), 1.0));
}
